# .env.example — copy to backend/.env and fill in values

DATABASE_URL=postgresql+asyncpg://terapanth:terapanth@localhost:5432/terapanth

# "groq" or "ollama"
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_key_here

# Embeddings via Ollama (Groq has no embeddings endpoint)
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
OPENAI_API_KEY=ollama

# Reranker — Jina (leave empty to fall back to score-based ranking)
JINA_API_KEY=your_jina_key_here

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=52428800
